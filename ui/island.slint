component BatteryGlyph inherits Rectangle {
    in property <float> level: 0.0;
    in property <bool> charging: false;

    width: 20px;
    height: 10px;
    border-radius: 3px;
    border-width: 1px;
    border-color: charging ? #6ee7b780 : (level < 0.15 ? #ff8f8f80 : #ffffff66);
    background: transparent;

    Rectangle {
        x: parent.width + 1px;
        y: 3px;
        width: 2px;
        height: 4px;
        border-radius: 1px;
        background: charging ? #6ee7b7b0 : #ffffff66;
    }

    Rectangle {
        x: 2px;
        y: 2px;
        width: max(0px, (parent.width - 4px) * max(0.0, min(1.0, level)));
        height: 6px;
        border-radius: 1px;
        background: charging ? #6ee7b7 : (level < 0.15 ? #ff8f8f : (level < 0.4 ? #ffc46b : #cfe0ff));
    }
}

component StatusChip inherits Rectangle {
    in property <string> label;
    in property <color> tone: #99a3b7;

    height: 18px;
    width: 58px;
    border-radius: 9px;
    background: #ffffff0a;
    border-width: 1px;
    border-color: #ffffff10;

    Text {
        x: 7px;
        width: max(0px, parent.width - 14px);
        height: parent.height;
        text: root.label;
        color: root.tone;
        font-size: 10px;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component Island inherits Window {
    title: "Glass Island";
    width: 420px;
    height: 180px;
    background: transparent;

    in-out property <float> expansion: 0.0;
    in-out property <float> battery-level: -1.0;
    in-out property <bool> charging: false;
    in-out property <string> battery-text: "";
    in-out property <string> battery-percent-text: "";
    in-out property <string> media-title: "Nothing playing";
    in-out property <string> media-detail: "No active player";
    in-out property <image> media-art;
    in-out property <bool> media-art-available: false;
    in-out property <string> media-initial: "♪";
    in-out property <float> media-progress: 0.0;
    in-out property <bool> media-progress-available: false;
    in-out property <string> media-time-text: "";
    in-out property <bool> volume-available: false;
    in-out property <bool> volume-muted: false;
    in-out property <string> volume-text: "";
    in-out property <bool> notification-active: false;
    in-out property <string> notification-app: "";
    in-out property <string> notification-summary: "";
    in-out property <string> notification-body: "";
    in-out property <string> notification-initial: "!";
    in-out property <bool> system-available: false;
    in-out property <string> cpu-text: "";
    in-out property <string> ram-text: "";

    callback toggle-requested();
    callback close-requested();

    out property <length> pill-width: 256px + (392px - 256px) * root.expansion;
    out property <length> pill-height: 58px + (164px - 58px) * root.expansion;

    pill := Rectangle {
        x: (parent.width - self.width) / 2;
        y: 0px;
        width: root.pill-width;
        height: root.pill-height;
        border-radius: min(root.pill-height / 2, 26px + 10px * root.expansion);
        clip: true;

        background: @linear-gradient(142deg, #363b48e6 0%, #1c2028d8 46%, #0c0e13e8 100%);
        border-width: 1px;
        border-color: #ffffff30;

        Rectangle {
            x: 1px;
            y: 1px;
            width: max(0px, parent.width - 2px);
            height: max(0px, parent.height - 2px);
            border-radius: max(0px, parent.border-radius - 1px);
            background: transparent;
            border-width: 1px;
            border-color: #ffffff12;
        }

        Rectangle {
            x: 22px;
            y: 1px;
            width: max(0px, parent.width - 44px);
            height: 1px;
            background: @linear-gradient(90deg, #ffffff00 0%, #ffffff66 50%, #ffffff00 100%);
        }

        Rectangle {
            x: 34px;
            y: max(0px, parent.height - 1px);
            width: max(0px, parent.width - 68px);
            height: 1px;
            background: @linear-gradient(90deg, #00000000 0%, #00000066 50%, #00000000 100%);
        }

        TouchArea {
            clicked => {
                root.toggle-requested();
            }
        }

        // Compact header. The right-side battery chip fades out as the island
        // expands so the close button never overlaps it.
        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: 58px;
            background: transparent;

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 16px;
                spacing: 10px;
                alignment: center;

                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: root.charging ? #6ee7b7 : #8ab4ff;
                }

                Text {
                    text: "GLASS ISLAND";
                    color: #f4f6ff;
                    font-size: 13px;
                    font-weight: 700;
                    letter-spacing: 1px;
                    vertical-alignment: center;
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                if root.battery-level >= 0 && root.expansion < 0.55: Rectangle {
                    width: 70px;
                    height: 24px;
                    border-radius: 12px;
                    opacity: max(0.0, 1.0 - root.expansion * 2.4);
                    animate opacity { duration: 140ms; }
                    background: #ffffff10;
                    border-width: 1px;
                    border-color: root.charging ? #6ee7b728 : #ffffff18;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 9px;
                        spacing: 6px;
                        alignment: center;

                        BatteryGlyph {
                            level: max(0.0, min(1.0, root.battery-level));
                            charging: root.charging;
                        }

                        Text {
                            text: root.battery-percent-text;
                            color: root.battery-level < 0.2 ? #ffb4b4 : (root.charging ? #b8f0d3 : #dfe7f6);
                            font-size: 10px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Expanded content. Media and notification panes cross-fade, keeping the
        // shared status row stable and the compact state untouched.
        Rectangle {
            x: 0px;
            y: 58px;
            width: parent.width;
            height: max(0px, parent.height - 58px);
            background: transparent;
            opacity: root.expansion;
            clip: true;

            Rectangle {
                x: 18px;
                y: 0px;
                width: max(0px, parent.width - 36px);
                height: 1px;
                background: #ffffff14;
            }

            media-pane := Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                opacity: root.notification-active ? 0.0 : 1.0;
                animate opacity { duration: 160ms; }

                VerticalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    padding-top: 8px;
                    padding-bottom: 30px;
                    spacing: 4px;

                    HorizontalLayout {
                        height: 11px;
                        spacing: 8px;

                        Text {
                            text: "NOW PLAYING";
                            color: #8d97aa;
                            font-size: 9px;
                            font-weight: 700;
                            letter-spacing: 1.4px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        if root.media-time-text != "": Text {
                            text: root.media-time-text;
                            color: #778196;
                            font-size: 9px;
                            vertical-alignment: center;
                        }
                    }

                    HorizontalLayout {
                        height: 50px;
                        spacing: 12px;
                        cross-axis-alignment: center;

                        Rectangle {
                            width: 50px;
                            height: 50px;
                            border-radius: 12px;
                            clip: true;
                            background: @linear-gradient(145deg, #4a5163 0%, #232833 100%);
                            border-width: 1px;
                            border-color: #ffffff2b;

                            if root.media-art-available: Image {
                                source: root.media-art;
                                width: 100%;
                                height: 100%;
                                image-fit: cover;
                            }

                            if !root.media-art-available: Text {
                                text: root.media-initial;
                                color: #e9efff;
                                font-size: 20px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        VerticalLayout {
                            spacing: 3px;
                            horizontal-stretch: 1;
                            alignment: center;

                            Text {
                                text: root.media-title;
                                color: #f4f6ff;
                                font-size: 14px;
                                font-weight: 600;
                                overflow: elide;
                            }

                            Text {
                                text: root.media-detail;
                                color: #99a3b7;
                                font-size: 10px;
                                overflow: elide;
                            }

                            if root.media-progress-available: Rectangle {
                                width: root.pill-width - 98px;
                                height: 3px;
                                border-radius: 1.5px;
                                background: #ffffff16;

                                Rectangle {
                                    x: 0px;
                                    y: 0px;
                                    width: parent.width * max(0.0, min(1.0, root.media-progress));
                                    height: parent.height;
                                    border-radius: 1.5px;
                                    background: @linear-gradient(90deg, #7da7f8 0%, #b6d0ff 100%);
                                }

                                Rectangle {
                                    x: max(0px, parent.width * max(0.0, min(1.0, root.media-progress)) - 2px);
                                    y: -1px;
                                    width: 5px;
                                    height: 5px;
                                    border-radius: 2.5px;
                                    background: #dbe8ff;
                                    visible: root.media-progress > 0.001;
                                }
                            }
                        }
                    }
                }
            }

            notification-pane := Rectangle {
                x: 0px;
                y: root.notification-active ? 0px : 3px;
                width: parent.width;
                height: parent.height;
                opacity: root.notification-active ? 1.0 : 0.0;
                animate opacity { duration: 160ms; }
                animate y { duration: 160ms; }

                VerticalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    padding-top: 8px;
                    padding-bottom: 30px;
                    spacing: 4px;

                    HorizontalLayout {
                        height: 11px;
                        spacing: 8px;

                        Text {
                            text: "NOTIFICATION";
                            color: #8db4ff;
                            font-size: 9px;
                            font-weight: 700;
                            letter-spacing: 1.4px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        Text {
                            text: root.notification-app;
                            color: #9ba7bc;
                            font-size: 9px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }

                    HorizontalLayout {
                        height: 50px;
                        spacing: 12px;
                        cross-axis-alignment: center;

                        Rectangle {
                            width: 46px;
                            height: 46px;
                            border-radius: 12px;
                            clip: true;
                            background: @linear-gradient(145deg, #3d4f6e 0%, #18202e 100%);
                            border-width: 1px;
                            border-color: #8ab4ff45;

                            Rectangle {
                                x: 5px;
                                y: 5px;
                                width: parent.width - 10px;
                                height: parent.height - 10px;
                                border-radius: 8px;
                                background: transparent;
                                border-width: 1px;
                                border-color: #ffffff12;
                            }

                            Text {
                                text: root.notification-initial;
                                color: #e9efff;
                                font-size: 18px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: 1;
                            alignment: center;

                            Text {
                                text: root.notification-summary;
                                color: #f4f6ff;
                                font-size: 13px;
                                font-weight: 600;
                                overflow: elide;
                            }

                            Text {
                                text: root.notification-body;
                                color: #99a3b7;
                                font-size: 10px;
                                overflow: elide;
                            }
                        }
                    }
                }
            }

            // Shared status row: battery, volume, CPU, RAM.
            HorizontalLayout {
                x: 18px;
                y: parent.height - 27px;
                width: parent.width - 36px;
                height: 18px;
                spacing: 6px;

                if root.battery-level >= 0: StatusChip {
                    width: 110px;
                    label: root.battery-text;
                    tone: root.battery-level < 0.2 ? #ffb4b4 : (root.charging ? #a9e8c8 : #99a3b7);
                }

                if root.volume-available: StatusChip {
                    label: root.volume-text;
                    tone: root.volume-muted ? #ff9f9f : #99a3b7;
                }

                if root.system-available: StatusChip {
                    label: root.cpu-text;
                }

                if root.system-available: StatusChip {
                    label: root.ram-text;
                }

                Rectangle {
                    horizontal-stretch: 1;
                }
            }

            close := Rectangle {
                x: max(0px, parent.width - 34px);
                y: 12px;
                width: 22px;
                height: 22px;
                border-radius: 11px;
                background: close-ta.pressed ? #ffffff2a : (close-ta.has-hover ? #ffffff1c : #ffffff10);
                border-width: 1px;
                border-color: #ffffff1c;
                visible: root.expansion > 0.55;

                Text {
                    text: "×";
                    color: #cbd4e4;
                    font-size: 14px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                close-ta := TouchArea {
                    enabled: root.expansion > 0.55;
                    clicked => {
                        root.close-requested();
                    }
                }
            }
        }
    }
}
